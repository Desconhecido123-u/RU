import React, { useState, useEffect, useRef } from 'react';
import { 
  StyleSheet, 
  Text, 
  View, 
  TouchableOpacity, 
  SafeAreaView, 
  Animated, 
  Dimensions,
  ActivityIndicator,
  StatusBar
} from 'react-native';

const { width } = Dimensions.get('window');

// --- COMPONENTES AUXILIARES ---

const Button = ({ title, onPress, color = '#2ECC71', textColor = '#FFF', disabled = false }) => (
  <TouchableOpacity 
    activeOpacity={0.8} 
    style={[styles.button, { backgroundColor: color, opacity: disabled ? 0.6 : 1 }]} 
    onPress={onPress}
    disabled={disabled}
  >
    <Text style={[styles.buttonText, { color: textColor }]}>{title}</Text>
  </TouchableOpacity>
);

const Card = ({ label, selected, onPress }) => (
  <TouchableOpacity 
    style={[styles.card, selected && styles.cardSelected]} 
    onPress={onPress}
  >
    <Text style={[styles.cardText, selected && styles.cardTextSelected]}>{label}</Text>
  </TouchableOpacity>
);

// --- TELA PRINCIPAL (LOGICA DE NAVEGAÇÃO) ---

export default function App() {
  // Estados do Fluxo
  const [step, setStep] = useState('splash'); // splash, home, gps, q1, q2, loading, result
  const [isOnQueue, setIsOnQueue] = useState(null);
  const [queueEnd, setQueueEnd] = useState('');
  const [loading, setLoading] = useState(false);

  // Animações
  const fadeAnim = useRef(new Animated.Value(0)).current;

  useEffect(() => {
    // Efeito de Fade In sempre que mudar de tela
    fadeAnim.setValue(0);
    Animated.timing(fadeAnim, {
      toValue: 1,
      duration: 500,
      useNativeDriver: true,
    }).start();

    // Lógica Automática da Splash
    if (step === 'splash') {
      setTimeout(() => setStep('home'), 2500);
    }
  }, [step]);

  // Simulação de Envio para Backend (FastAPI ready)
  const handleSend = () => {
    setLoading(true);
    setStep('loading');
    
    // Simulando delay de rede
    setTimeout(() => {
      setLoading(false);
      setStep('result');
    }, 2000);
  };

  // --- RENDERIZAÇÃO DE TELAS ---

  const renderContent = () => {
    switch (step) {
      case 'splash':
        return (
          <View style={styles.center}>
            <View style={styles.logoCircle}>
              <Text style={{fontSize: 50}}>🍽️</Text>
            </View>
            <Text style={styles.logoText}>FilaRural</Text>
          </View>
        );

      case 'home':
        return (
          <View style={styles.containerStep}>
            <Text style={styles.title}>FilaRural</Text>
            <Text style={styles.subtitle}>Veja o tamanho da fila do RU em tempo real e ajude a comunidade.</Text>
            <Button title="Começar" onPress={() => setStep('gps')} />
          </View>
        );

      case 'gps':
        return (
          <View style={styles.containerStep}>
            <Text style={styles.emoji}>📍</Text>
            <Text style={styles.titleSmall}>Verificação de Presença</Text>
            <Text style={styles.description}>
              Precisamos da sua localização para validar sua presença no Restaurante Universitário.
            </Text>
            <Button title="Permitir Localização" onPress={() => setStep('q1')} />
          </View>
        );

      case 'q1':
        return (
          <View style={styles.containerStep}>
            <Text style={styles.titleSmall}>Você está na fila agora?</Text>
            <Button title="Sim, estou na fila" onPress={() => { setIsOnQueue(true); setStep('q2'); }} />
            <View style={{ height: 15 }} />
            <Button 
              title="Não estou na fila" 
              color="#E0E0E0" 
              textColor="#757575" 
              onPress={() => setStep('result')} 
            />
          </View>
        );

      case 'q2':
        return (
          <View style={styles.containerStep}>
            <Text style={styles.titleSmall}>Onde está o final da fila?</Text>
            <View style={styles.cardGrid}>
              {['Entrada', 'Árvore', 'Banco', 'Portão'].map((item) => (
                <Card 
                  key={item} 
                  label={item} 
                  selected={queueEnd === item} 
                  onPress={() => setQueueEnd(item)} 
                />
              ))}
            </View>
            <Button title="Enviar Informações" disabled={!queueEnd} onPress={handleSend} />
          </View>
        );

      case 'loading':
        return (
          <View style={styles.center}>
            <ActivityIndicator size="large" color="#2ECC71" />
            <Text style={styles.loadingText}>Processando dados...</Text>
          </View>
        );

      case 'result':
        return (
          <View style={styles.containerStep}>
            <Text style={styles.titleSmall}>Status da Fila</Text>
            <View style={styles.resultBox}>
              <View style={styles.resultItem}>
                <Text style={styles.resultLabel}>Distância</Text>
                <Text style={styles.resultValue}>45 metros</Text>
              </View>
              <View style={styles.divider} />
              <View style={styles.resultItem}>
                <Text style={styles.resultLabel}>Tempo Médio</Text>
                <Text style={styles.resultValue}>12 minutos</Text>
              </View>
            </View>
            <Button title="Voltar ao Início" color="#f1f1f1" textColor="#333" onPress={() => setStep('home')} />
          </View>
        );
    }
  };

  return (
    <SafeAreaView style={styles.safeArea}>
      <StatusBar barStyle="dark-content" />
      <Animated.View style={[styles.mainContainer, { opacity: fadeAnim }]}>
        {renderContent()}
      </Animated.View>
    </SafeAreaView>
  );
}

