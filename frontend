import React, { useState, useEffect, useRef } from 'react';
import { 
  StyleSheet, 
  Text, 
  View, 
  TouchableOpacity, 
  SafeAreaView, 
  Animated, 
  Dimensions,
  ActivityIndicator,
  StatusBar,
  ScrollView
} from 'react-native';

// Obtemos a largura da tela do dispositivo para ajustes de layout responsivo
const { width } = Dimensions.get('window');

// --- DESIGN SYSTEM (Definição das cores globais para fácil manutenção) ---
const COLORS = {
  primaryBlue: '#2F4DA0',    // Azul institucional usado no Header
  modernBlue: '#3B5BDB',     // Azul vibrante para botões de ação
  lightBlue: '#E7F0FF',      // Fundo suave para caixas de informação
  positiveGreen: '#2D6A4F',  // Verde escuro para textos de confirmação
  lightGreen: '#D8F3DC',     // Verde claro para o card de "Fila Tranquila"
  background: '#F8F9FA',     // Cor de fundo leve para o app todo
  white: '#FFFFFF',          // Branco puro para cards e textos no azul
  secondaryText: '#6C757D',  // Cinza para descrições e textos menos importantes
  darkText: '#212529',       // Preto suave para melhor leitura
  border: '#DEE2E6'          // Cor padrão para bordas e divisores
};

// --- COMPONENTES AUXILIARES ---

// Componente do Topo (Header) com animação no indicador "AO VIVO"
const Header = () => {
  const pulseAnim = useRef(new Animated.Value(1)).current; // Cria uma referência para o valor da animação

  useEffect(() => {
    // Configura uma animação infinita de "pulsação" (opacidade)
    Animated.loop(
      Animated.sequence([
        Animated.timing(pulseAnim, { toValue: 0.3, duration: 1000, useNativeDriver: true }),
        Animated.timing(pulseAnim, { toValue: 1, duration: 1000, useNativeDriver: true }),
      ])
    ).start();
  }, []);

  return (
    <View style={styles.header}>
      <Text style={styles.headerTitle}>FilaRural</Text>
      <View style={styles.liveBadge}>
        {/* O ponto vermelho que pisca */}
        <Animated.View style={[styles.liveDot, { opacity: pulseAnim }]} />
        <Text style={styles.liveText}>AO VIVO</Text>
      </View>
    </View>
  );
};

// Componente de Botão Reutilizável
const Button = ({ title, onPress, color = COLORS.modernBlue, textColor = COLORS.white, outline = false, disabled = false }) => (
  <TouchableOpacity 
    activeOpacity={0.8} // Efeito visual de clique
    style={[
      styles.button, 
      { backgroundColor: outline ? 'transparent' : color, opacity: disabled ? 0.6 : 1 },
      outline && { borderWidth: 2, borderColor: COLORS.border } // Estilo se for apenas borda
    ]} 
    onPress={onPress}
    disabled={disabled}
  >
    <Text style={[styles.buttonText, { color: outline ? COLORS.secondaryText : textColor }]}>{title}</Text>
  </TouchableOpacity>
);

// Componente das barras do gráfico de fluxo
const ChartBar = ({ label, value, active = false }) => (
  <View style={styles.barContainer}>
    <View style={[styles.barBackground, { height: 80 }]}>
      {/* A altura da barra é definida pela prop 'value' */}
      <View style={[styles.barFill, { height: value, backgroundColor: active ? COLORS.modernBlue : '#CED4DA' }]} />
    </View>
    <Text style={[styles.barLabel, active && { fontWeight: 'bold', color: COLORS.darkText }]}>{label}</Text>
  </View>
);

// --- TELA PRINCIPAL ---

export default function App() {
  // ESTADOS: Controlam o que aparece na tela e os dados do usuário
  const [step, setStep] = useState('splash'); // Controla qual "etapa" ou tela está ativa
  const [queueEnd, setQueueEnd] = useState(''); // Armazena o local do fim da fila selecionado
  const fadeAnim = useRef(new Animated.Value(0)).current; // Valor para o efeito de transição entre telas

  // Efeito executado sempre que a tela (step) muda
  useEffect(() => {
    fadeAnim.setValue(0); // Reinicia a opacidade para 0
    Animated.timing(fadeAnim, { toValue: 1, duration: 400, useNativeDriver: true }).start(); // Faz o Fade In
    
    // Se estiver na Splash, espera 2 segundos e vai para a Home automaticamente
    if (step === 'splash') setTimeout(() => setStep('home'), 2000);
  }, [step]);

  // FUNÇÃO DE RENDERIZAÇÃO: Escolhe qual conteúdo mostrar baseado no 'step'
  const renderContent = () => {
    switch (step) {
      case 'splash':
        return (
          <View style={styles.center}>
            <View style={styles.logoCircle}><Text style={{fontSize: 60}}>🌾</Text></View>
            <Text style={styles.logoText}>FilaRural</Text>
          </View>
        );

      case 'home':
        return (
          <View style={styles.fullContent}>
            <Header />
            <ScrollView contentContainerStyle={styles.containerStep}>
              <View style={styles.infoBox}>
                <Text style={styles.infoText}>ℹ️ Campus Rural - Restaurante Universitário</Text>
              </View>
              <Text style={styles.title}>Fila em Tempo Real</Text>
              <Text style={styles.subtitle}>Veja como está a movimentação do RU agora e evite filas.</Text>
              
              <View style={styles.chartSection}>
                <Text style={styles.sectionTitle}>Fluxo de Ocupação Hoje</Text>
                <View style={styles.chartRow}>
                  <ChartBar label="07h" value={15} />
                  <ChartBar label="11h" value={80} active />
                  <ChartBar label="13h" value={45} />
                  <ChartBar label="18h" value={65} />
                </View>
              </View>

              <Button title="Consultar Fila" onPress={() => setStep('gps')} />
            </ScrollView>
          </View>
        );

      case 'gps':
        return (
          <View style={styles.fullContent}>
            <Header />
            <View style={styles.containerStep}>
              <Text style={styles.emoji}>📍</Text>
              <Text style={styles.titleSmall}>Verificar Localização</Text>
              <Text style={styles.description}>Precisamos confirmar que você está no campus para validar os dados.</Text>
              <Button title="Permitir Acesso" onPress={() => setStep('q1')} />
            </View>
          </View>
        );

      case 'q1':
        return (
          <View style={styles.fullContent}>
            <Header />
            <View style={styles.containerStep}>
              <Text style={styles.titleSmall}>Você está na fila?</Text>
              <Button title="Sim, estou na fila" onPress={() => setStep('q2')} />
              <View style={{ height: 12 }} />
              <Button title="Não, quero apenas ver" outline onPress={() => setStep('result')} />
            </View>
          </View>
        );

      case 'q2':
        return (
          <View style={styles.fullContent}>
            <Header />
            <View style={styles.containerStep}>
              <Text style={styles.titleSmall}>Onde a fila termina?</Text>
              <View style={styles.cardGrid}>
                {['Entrada', 'Árvore', 'Banco', 'Portão'].map((item) => (
                  <TouchableOpacity 
                    key={item} 
                    style={[styles.card, queueEnd === item && styles.cardSelected]} 
                    onPress={() => setQueueEnd(item)} // Salva a escolha do usuário
                  >
                    <Text style={[styles.cardText, queueEnd === item && styles.cardTextSelected]}>{item}</Text>
                  </TouchableOpacity>
                ))}
              </View>
              <Button 
                title="Confirmar e Ver Resultado" 
                disabled={!queueEnd} // Desabilita se nada for selecionado
                onPress={() => {setStep('loading'); setTimeout(() => setStep('result'), 1500);}} 
              />
            </View>
          </View>
        );

      case 'loading':
        return (
          <View style={styles.center}>
            <ActivityIndicator size="large" color={COLORS.primaryBlue} />
            <Text style={styles.loadingText}>Sincronizando dados...</Text>
          </View>
        );

      case 'result':
        return (
          <View style={styles.fullContent}>
            <Header />
            <ScrollView contentContainerStyle={styles.containerStep}>
              {/* Card Verde de Status */}
              <View style={styles.statusMainCard}>
                <View style={styles.statusHeader}>
                   <Text style={styles.statusTitle}>Fila tranquila!</Text>
                   <Text style={{fontSize: 24}}>🔄</Text>
                </View>
                <Text style={styles.statusDescription}>O fluxo está rápido. Ótimo momento para ir ao RU!</Text>
              </View>

              {/* Box Branco com os resultados numéricos */}
              <View style={styles.resultBox}>
                <View style={styles.resultItem}>
                  <Text style={styles.resultLabel}>TEMPO DE ESPERA</Text>
                  <Text style={[styles.resultValue, {color: COLORS.positiveGreen}]}>12 min</Text>
                </View>
                <View style={styles.divider} />
                <View style={styles.resultItem}>
                  <Text style={styles.resultLabel}>TAMANHO DA FILA</Text>
                  <Text style={styles.resultValue}>45 metros</Text>
                </View>
              </View>

              <Button title="Voltar ao Início" onPress={() => setStep('home')} />
              <View style={{ height: 20 }} />
              <Text style={styles.footerNote}>Última atualização: agora mesmo</Text>
            </ScrollView>
          </View>
        );
    }
  };

  return (
    <SafeAreaView style={styles.safeArea}>
      <StatusBar barStyle="light-content" backgroundColor={COLORS.primaryBlue} />
      <Animated.View style={[styles.mainContainer, { opacity: fadeAnim }]}>
        {renderContent()}
      </Animated.View>
    </SafeAreaView>
  );
}

